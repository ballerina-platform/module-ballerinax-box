};

# A full representation of a file, as can be returned from any
# file API endpoints by default
public type FileFull record {
    *File;
    # The number of comments on this file.
    @jsondata:Name {value: "comment_count"}
    int commentCount?;
    # Indicates the (optional) file extension for this file. By default,
    # this is set to an empty string.
    string extension?;
    record {|record {|MetadataFull...;|}...;|} metadata?;
    @jsondata:Name {value: "watermark_info"}
    record {@jsondata:Name {value: "is_watermarked"}
        boolean isWatermarked?; @jsondata:Name {value: "is_watermarked_by_access_policy"}
        boolean isWatermarkedByAccessPolicy?; @jsondata:Name {value: "is_watermark_inherited"}
        boolean isWatermarkInherited?;} watermarkInfo?;
    # A stable API URL for the file content endpoint,
    # `/2.0/files/{id}/content`. Unlike `download_url`, authorization is
    # evaluated when the URL is requested with a valid access token.
    # 
    # This field is only returned for files, not folders or web links.
    @jsondata:Name {value: "authenticated_download_url"}
    string authenticatedDownloadUrl?;
    # The retention expiration timestamp for the given file.
    @jsondata:Name {value: "disposition_at"}
    string? dispositionAt?;
    # The shared link access levels the authenticated user is allowed to
    # use when creating or updating a shared link for this file.
    # 
    # The list depends on item policy and user authorization, so it may be
    # narrower than the levels available to the owner. An empty array means
    # no access level is available to this user.
    @jsondata:Name {value: "allowed_shared_link_access_levels"}
    ("open"|"company"|"collaborators")[] allowedSharedLinkAccessLevels?;
    # The version number of this file.
    @jsondata:Name {value: "version_number"}
    string versionNumber?;
    # Specifies if this file has any other collaborators.
    @jsondata:Name {value: "has_collaborations"}
    boolean hasCollaborations?;
    record {record {string representation?; record {@jsondata:Name {value: "url_template"}
                string urlTemplate?;} content?; record {string paged?; string thumb?; string dimensions?;} properties?; record {string url?;} info?; record {"success"|"viewable"|"pending"|"none" state?;} status?;}[] entries?;} representations?;
    # When the file will automatically be deleted.
    @jsondata:Name {value: "expires_at"}
    string? expiresAt?;
    # The collections that this file belongs to.
    # 
    # For more information, see the
    # [collections guide](https://developer.box.com/guides/collections).
    Collection[] collections?;
    record {@jsondata:Name {value: "can_invite_collaborator"}
        boolean canInviteCollaborator; @jsondata:Name {value: "can_set_share_access"}
        boolean canSetShareAccess; @jsondata:Name {value: "can_delete"}
        boolean canDelete; @jsondata:Name {value: "can_share"}
        boolean canShare; @jsondata:Name {value: "can_rename"}
        boolean canRename; @jsondata:Name {value: "can_download"}
        boolean canDownload; @jsondata:Name {value: "can_comment"}
        boolean canComment; @jsondata:Name {value: "can_view_annotations_all"}
        boolean canViewAnnotationsAll; @jsondata:Name {value: "can_upload"}
        boolean canUpload; @jsondata:Name {value: "can_preview"}
        boolean canPreview; @jsondata:Name {value: "can_view_annotations_self"}
        boolean canViewAnnotationsSelf; @jsondata:Name {value: "can_annotate"}
        boolean canAnnotate; @jsondata:Name {value: "can_apply_watermark"}
        boolean canApplyWatermark?;} permissions?;
    # This field will return true if the file or any ancestor of the file
    # is associated with at least one app item. Note that this will return
    # true even if the context user does not have access to the app item(s)
    # associated with the file.
    @jsondata:Name {value: "is_associated_with_app_item"}
    boolean isAssociatedWithAppItem?;
    # A pre-authorized, expiring URL for directly downloading the file's
    # content. Requires authentication and is valid only for the current
    # session.
    # 
    # This field is only returned for files, not folders or web links.
    @jsondata:Name {value: "download_url"}
    string downloadUrl?;
    record {@jsondata:Name {value: "is_download_prevented"}
        boolean isDownloadPrevented?; @jsondata:Name {value: "app_type"}
        "gsuite"|"office_wopi"|"office_wopiplus"|"other"? appType?; @jsondata:Name {value: "created_at"}
        string createdAt?; string id?; @jsondata:Name {value: "expired_at"}
        string expiredAt?; "lock" 'type?; @jsondata:Name {value: "created_by"}
        UserMini createdBy?;}? 'lock?;
    # Indicates if the file is a package. Packages are commonly used
    # by Mac Applications and can include iWork files.
    @jsondata:Name {value: "is_package"}
    boolean isPackage?;
    # A list of the types of roles that user can be invited at
    # when sharing this file.
    @jsondata:Name {value: "allowed_invitee_roles"}
    ("editor"|"viewer"|"previewer"|"uploader"|"previewer uploader"|"viewer uploader"|"co-owner")[] allowedInviteeRoles?;
    # A list of the types of roles that user can be invited at
    # when sharing this file.
    @jsondata:Name {value: "shared_link_permission_options"}
    ("can_preview"|"can_download"|"can_edit")[]? sharedLinkPermissionOptions?;
    @jsondata:Name {value: "expiring_embed_link"}
    record {@jsondata:Name {value: "access_token"}
        string accessToken?; @jsondata:Name {value: "token_type"}
        "bearer" tokenType?; @jsondata:Name {value: "expires_in"}
        int expiresIn?; @jsondata:Name {value: "restricted_to"}
        ResourceScope[] restrictedTo?; string url?;} expiringEmbedLink?;
    # Whether the file's binary content is eligible to be downloaded.
    # 
    # This is a content-level flag and does not reflect whether the
    # current user is authorized to download the file. Use
    # `permissions.can_download`, when available, for that.
    @jsondata:Name {value: "is_download_available"}
    boolean isDownloadAvailable?;
    # Specifies if this file is owned by a user outside of the
    # authenticated enterprise.
    @jsondata:Name {value: "is_externally_owned"}
    boolean isExternallyOwned?;
    record {string color?; string name?; string definition?;}? classification?;
    # Specifies if the file can be accessed
    # via the direct shared link or a shared link
    # to a parent folder.
    @jsondata:Name {value: "is_accessible_via_shared_link"}
    boolean isAccessibleViaSharedLink?;
    string[] tags?;
    @jsondata:Name {value: "uploader_display_name"}
    string uploaderDisplayName?;
};

# A collection of items, including files and folders.
# 
# Currently, the only collection available
# is the `favorites` collection.
# 
# The contents of a collection can be explored in a
# similar way to which the contents of a folder is
# explored
public type Collection record {
    # The name of the collection
    "Favorites" name?;
    # The unique identifier for this collection
    string id?;
    # The value will always be `collection`
    "collection" 'type?;
    # The type of the collection. This is used to
    # determine the proper visual treatment for
    # collections
    @jsondata:Name {value: "collection_type"}
    "favorites" collectionType?;
};

