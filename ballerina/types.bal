    FileMini? file?;
    # When the retention expires on this file
    # version retention
    @jsondata:Name {value: "disposition_at"}
    string dispositionAt?;
    @jsondata:Name {value: "winning_retention_policy"}
    RetentionPolicyMini winningRetentionPolicy?;
    # The unique identifier for this file version retention
    string id?;
    # The value will always be `file_version_retention`
    "file_version_retention" 'type?;
};

