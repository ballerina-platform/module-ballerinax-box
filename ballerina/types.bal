    # in a `cfr11` request flow. The value is `null` when not applicable.
    string? reason?;
    # Content type of input.
    @jsondata:Name {value: "content_type"}
    "signature"|"initial"|"stamp"|"date"|"checkbox"|"text"|"full_name"|"first_name"|"last_name"|"company"|"title"|"email"|"attachment"|"radio"|"dropdown" contentType?;
    # Indicates whether this input is read-only (cannot be modified by signers).
    @jsondata:Name {value: "read_only"}
    boolean readOnly?;
    # Index of page that the input is on.
    @jsondata:Name {value: "page_index"}
    int pageIndex;
    # Type of input.
    "signature"|"date"|"text"|"checkbox"|"radio"|"dropdown" 'type?;
    # Indicates whether the signer's input has been validated through re-authentication.
    # Applicable only for signature or initial content types in a `cfr11` request flow.
    # The value is `null` for standard request flows or non-applicable input types.
    @jsondata:Name {value: "is_validated"}
    boolean? isValidated?;
    # Specifies the formatting rules that signers must follow for text field inputs.
    # If set, this validation is mandatory.
    SignRequestSignerInputValidation|record {||} validation?;
};

# Specifies the US date formatting rules for a text field input by the signer. 
