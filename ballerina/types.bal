# A Box Sign request object
public type SignRequest record {
    *SignRequestBase;
    # Timestamp indicating when all signing actions completed.
    @jsondata:Name {value: "finished_at"}
    string? finishedAt?;
    # List of files to create a signing document from. This is currently limited to ten files. Only the ID and type fields are required for each file.
    @jsondata:Name {value: "source_files"}
    FileBase[] sourceFiles?;
    # Timestamp marking when the sign request was created.
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "signing_log"}
    FileMini? signingLog?;
    # Short identifier for the sign request.
    @jsondata:Name {value: "short_id"}
    string shortId?;
    # The value will always be `sign-request`.
    "sign-request" 'type?;
    # The user ID of the sender of the sign request.
    @jsondata:Name {value: "sender_id"}
    int? senderId?;
    # This URL is returned if `is_document_preparation_needed` is
    # set to `true` in the request. The parameter is used to prepare
    # the signature request
    # using the UI. The signature request is not
    # sent until the preparation
    # phase is complete.
    @jsondata:Name {value: "prepare_url"}
    string? prepareUrl?;
    # Array of signers for the signature request.
    SignRequestSigner[] signers?;
    # The collaborator level of the user to the sign request. Values can include "owner", "editor", and "viewer".
    @jsondata:Name {value: "collaborator_level"}
    string? collaboratorLevel?;
    @jsondata:Name {value: "parent_folder"}
    FolderMini parentFolder?;
    # Force a specific color for the signature (blue, black, or red).
    @jsondata:Name {value: "signature_color"}
    string? signatureColor?;
    # List of files that will be signed, which are copies of the original
    # source files. A new version of these files are created as signers sign
    # and can be downloaded at any point in the signing process.
    SignRequest_sign_files sign_files?;
    # When the sign request is in an error state, identifies the specific
    # reason. Null when no error code applies.
    @jsondata:Name {value: "error_code"}
    string? errorCode?;
    # Box Sign request ID.
    string id?;
    # Uses `days_valid` to calculate the date and time, in GMT, the sign request will expire if unsigned.
    @jsondata:Name {value: "auto_expire_at"}
    string? autoExpireAt?;
    # Describes the status of the signature request.
    "converting"|"created"|"sent"|"viewed"|"signed"|"cancelled"|"declined"|"error"|"error_converting"|"error_sending"|"expired"|"finalizing"|"error_finalizing" status?;
    # The email address of the sender of the sign request.
    @jsondata:Name {value: "sender_email"}
    string? senderEmail?;
};

