    string description?;
    # An arbitrary identifier that can be used by
    # external group sync tools to link this Box Group to
    # an external group.
    # 
    # Example values of this field
    # could be an **Active Directory Object ID** or a **Google
    # Group ID**.
    # 
    # We recommend you use of this field in
    # order to avoid issues when group names are updated in
    # either Box or external systems
    @jsondata:Name {value: "external_sync_identifier"}
    string externalSyncIdentifier?;
    # Specifies who can see the members of the group.
    # 
    # * `admins_only` - the enterprise admin, co-admins, group's
    #   group admin.
    # * `admins_and_members` - all admins and group members.
    # * `all_managed_users` - all managed users in the
    #   enterprise
    @jsondata:Name {value: "member_viewability_level"}
    "admins_only"|"admins_and_members"|"all_managed_users" memberViewabilityLevel?;
};

# Represents a trashed folder
public type TrashFolder record {
    FolderMini parent?;
    # The date and time when the folder was created. This value may
    # be `null` for some folders such as the root folder or the trash
    # folder
    @jsondata:Name {value: "created_at"}
    string? createdAt?;
    string description;
    # The date and time at which this folder was originally
    # created
    @jsondata:Name {value: "content_created_at"}
    string? contentCreatedAt?;
    @jsondata:Name {value: "owned_by"}
    UserMini ownedBy;
    # The value will always be `folder`
    "folder" 'type;
    # Defines if this item has been deleted or not.
    # 
    # * `active` when the item has is not in the trash
    # * `trashed` when the item has been moved to the trash but not deleted
    # * `deleted` when the item has been permanently deleted
    @jsondata:Name {value: "item_status"}
    "active"|"trashed"|"deleted" itemStatus;
    @jsondata:Name {value: "created_by"}
    UserMini createdBy;
    # The folder upload email for this folder. This will
    # be `null` if a folder has been trashed, since the upload will no longer
    # work
    @jsondata:Name {value: "folder_upload_email"}
    string? folderUploadEmail?;
    # The time at which this folder was put in the trash
    @jsondata:Name {value: "trashed_at"}
    string? trashedAt?;
    # The folder size in bytes.
    # 
    # Be careful parsing this integer as its
    # value can get very large
    int size;
    @jsondata:Name {value: "sequence_id"}
    string? sequenceId?;
    # The name of the folder
    string name;
    @jsondata:Name {value: "modified_by"}
    UserMini modifiedBy;
    # The time at which this folder is expected to be purged
    # from the trash
    @jsondata:Name {value: "purged_at"}
    string? purgedAt?;
    # The shared link for this folder. This will
    # be `null` if a folder has been trashed, since the link will no longer
    # be active
    @jsondata:Name {value: "shared_link"}
    string? sharedLink?;
    # The HTTP `etag` of this folder. This can be used within some API
    # endpoints in the `If-Match` and `If-None-Match` headers to only
    # perform changes on the folder if (no) changes have happened
    string? etag?;
    # The date and time at which this folder was last updated
    @jsondata:Name {value: "content_modified_at"}
    string? contentModifiedAt?;
    # The unique identifier that represent a folder.
    # 
    # The ID for any folder can be determined
    # by visiting a folder in the web application
    # and copying the ID from the URL. For example,
    # for the URL `https://*.app.box.com/folders/123`
    # the `folder_id` is `123`
    string id;
    # The date and time when the folder was last updated. This value may
    # be `null` for some folders such as the root folder or the trash
    # folder
    @jsondata:Name {value: "modified_at"}
    string? modifiedAt?;
    @jsondata:Name {value: "path_collection"}
    record {int total_count; record {"folder" 'type?; string id?; string? sequence_id?; string? etag?; string name?;}[] entries;} pathCollection;
};

