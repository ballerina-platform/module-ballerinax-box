# Collaborations define access permissions for users and groups to files and
# folders, similar to access control lists. A collaboration object grants a
# user or group access to a file or folder with permissions defined by a
# specific role
public type Collaboration record {
    CollaborationItem? item?;
    @jsondata:Name {value: "acceptance_requirements_status"}
    CollaborationAcceptanceRequirementsStatus acceptanceRequirementsStatus?;
    # The level of access granted
    "editor"|"viewer"|"previewer"|"uploader"|"previewer uploader"|"viewer uploader"|"co-owner"|"owner" role?;
    # If set to `true`, collaborators have access to
    # shared items, but such items won't be visible in the
    # All Files list. Additionally, collaborators won't
    # see the path to the root folder for the
    # shared item
    @jsondata:Name {value: "is_access_only"}
    boolean isAccessOnly?;
    @jsondata:Name {value: "app_item"}
    AppItem? appItem?;
    # When the collaboration object was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The value will always be `collaboration`
    "collaboration" 'type;
    @jsondata:Name {value: "created_by"}
    UserCollaborations createdBy?;
    # The email address used to invite an unregistered collaborator, if
    # they are not a registered user
    @jsondata:Name {value: "invite_email"}
    string? inviteEmail?;
    @jsondata:Name {value: "accessible_by"}
    CollaborationAccessGrantee accessibleBy?;
    # When the collaboration will expire, or `null` if no expiration
    # date is set
    @jsondata:Name {value: "expires_at"}
    string? expiresAt?;
    # The unique identifier for this collaboration
    string id;
    # When the collaboration object was last modified
    @jsondata:Name {value: "modified_at"}
    string modifiedAt?;
    # When the `status` of the collaboration object changed to
    # `accepted` or `rejected`
    @jsondata:Name {value: "acknowledged_at"}
    string acknowledgedAt?;
    # The status of the collaboration invitation. If the status
    # is `pending`, `name` returns an empty string
    "accepted"|"pending"|"rejected" status?;
};

public type CopyFolderRequest record {
