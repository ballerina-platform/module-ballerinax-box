# An instance of the classification metadata template, containing
# the classification applied to the file or folder.
# 
# To get more details about the classification applied to an item,
# request the classification metadata template
public type Classification record {
    # The scope of the enterprise that this classification has been
    # applied for.
    # 
    # This will be in the format `enterprise_{enterprise_id}`
    @jsondata:Name {value: "$scope"}
    string dollarScope?;
    # The value will always be `securityClassification-6VMVochwUWo`
    @jsondata:Name {value: "$template"}
    "securityClassification-6VMVochwUWo" dollarTemplate?;
    # The identifier of the item that this metadata instance
    # has been attached to. This combines the `type` and the `id`
    # of the parent in the form `{type}_{id}`
    @jsondata:Name {value: "$parent"}
    string dollarParent?;
    # The version of the metadata instance. This version starts at 0 and
    # increases every time a classification is updated
    @jsondata:Name {value: "$version"}
    int dollarVersion?;
    # The name of the classification applied to the item
    @jsondata:Name {value: "Box__Security__Classification__Key"}
    string boxSecurityClassificationKey?;
    # The version of the metadata template. This version starts at 0 and
    # increases every time the template is updated. This is mostly for internal
    # use
    @jsondata:Name {value: "$typeVersion"}
    decimal dollarTypeVersion?;
    # Whether an end user can change the classification
    @jsondata:Name {value: "$canEdit"}
    boolean dollarCanEdit?;
    # The unique ID of this classification instance. This will be include
    # the name of the classification template and a unique ID
    @jsondata:Name {value: "$type"}
    string dollarType?;
};

# Defines a lock on an item. This prevents the item from being
# moved, renamed, or otherwise changed by anyone other than the user
# who created the lock.
# 
# Set this to `null` to remove the lock
public type FileLock record {
    # Defines if the file can be downloaded while it is locked
    @jsondata:Name {value: "is_download_prevented"}
    boolean isDownloadPrevented?;
    # The type of this object
    "lock" access?;
    # Defines the time at which the lock expires
    @jsondata:Name {value: "expires_at"}
    string expiresAt?;
};

# The AppItem that triggered an event in the event stream
public type AppItemEventSource record {
    # The type of the `AppItem`
    @jsondata:Name {value: "app_item_type"}
    string appItemType;
    # The id of the `AppItem`
    string id;
    # The type of the source that this event represents. Can only be `app_item`
    "app_item" 'type;
    UserMini user?;
    GroupMini group?;
};

