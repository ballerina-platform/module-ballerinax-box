# A standard representation of a file, as returned from any
# file API endpoints by default
public type File record {
    *FileMini;
    FolderMini? parent?;
    # The optional description of this file.
    # If the description exceeds 255 characters, the first 255 characters
    # are set as a file description and the rest of it is ignored.
    string description?;
    # The date and time when the file was created on Box.
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The date and time at which this file was originally
    # created, which might be before it was uploaded to Box.
    @jsondata:Name {value: "content_created_at"}
    string? contentCreatedAt?;
    @jsondata:Name {value: "owned_by"}
    UserMini ownedBy?;
    # Defines if this item has been deleted or not.
    # 
    # * `active` when the item has is not in the trash
    # * `trashed` when the item has been moved to the trash but not deleted
    # * `deleted` when the item has been permanently deleted.
    @jsondata:Name {value: "item_status"}
    "active"|"trashed"|"deleted" itemStatus?;
    @jsondata:Name {value: "created_by"}
    UserMini createdBy?;
    # The time at which this file was put in the trash.
    @jsondata:Name {value: "trashed_at"}
    string? trashedAt?;
    # The file size in bytes. Be careful parsing this integer as it can
    # get very large and cause an integer overflow.
    int size?;
    # The time at which this file is expected to be purged
    # from the trash.
    @jsondata:Name {value: "purged_at"}
    string? purgedAt?;
    @jsondata:Name {value: "modified_by"}
    UserMini modifiedBy?;
    @jsondata:Name {value: "shared_link"}
    record {@jsondata:Name {value: "is_password_enabled"}
        boolean isPasswordEnabled; @jsondata:Name {value: "vanity_name"}
        string? vanityName?; "open"|"company"|"collaborators" access?; record {@jsondata:Name {value: "can_edit"}
            boolean canEdit; @jsondata:Name {value: "can_preview"}
            boolean canPreview; @jsondata:Name {value: "can_download"}
            boolean canDownload;} permissions?; @jsondata:Name {value: "download_url"}
        string? downloadUrl?; @jsondata:Name {value: "effective_access"}
        "open"|"company"|"collaborators" effectiveAccess; @jsondata:Name {value: "effective_permission"}
        "can_edit"|"can_download"|"can_preview"|"no_access" effectivePermission; @jsondata:Name {value: "vanity_url"}
        string? vanityUrl?; @jsondata:Name {value: "unshared_at"}
        string? unsharedAt?; @jsondata:Name {value: "preview_count"}
        int previewCount; string url; @jsondata:Name {value: "download_count"}
        int downloadCount;}? sharedLink?;
    # The date and time at which this file was last updated,
    # which might be before it was uploaded to Box.
    @jsondata:Name {value: "content_modified_at"}
    string? contentModifiedAt?;
    # The date and time when the file was last updated on Box.
    @jsondata:Name {value: "modified_at"}
    string modifiedAt?;
    @jsondata:Name {value: "path_collection"}
    record {FolderMini[] entries; @jsondata:Name {value: "total_count"}
        int totalCount;} pathCollection?;
};

public type UpdateUserRequest record {
    # Whether the user can see other enterprise users in their
    # contact list
    @jsondata:Name {value: "can_see_managed_users"}
    boolean canSeeManagedUsers?;
    # The user’s enterprise role
    "coadmin"|"user" role?;
    # The user’s address
    @constraint:String {maxLength: 255}
    string address?;
    @jsondata:Name {value: "notification_email"}
    UserNotificationEmail? notificationEmail?;
    # Set this to `null` to roll the user out of the enterprise
    # and make them a free user
    string? enterprise?;
    # The user's timezone
    string timezone?;
    # Whether the user must use two-factor authentication
    @jsondata:Name {value: "is_exempt_from_login_verification"}
    boolean isExemptFromLoginVerification?;
    # Whether the user is allowed to collaborate with users outside
    # their enterprise
    @jsondata:Name {value: "is_external_collab_restricted"}
    boolean isExternalCollabRestricted?;
    # The language of the user, formatted in modified version of the
    # [ISO 639-1](https://developer.box.com/guides/api-calls/language-codes) format
    string language?;
    # Whether collaborators can access content owned by the user when
    # the user is inactive. This setting preserves existing
    # collaborator access and does not grant new permissions
    @jsondata:Name {value: "is_collaborated_content_available_when_owner_inactive"}
    boolean isCollaboratedContentAvailableWhenOwnerInactive?;
    # The email address the user uses to log in
    # 
    # Note: If the target user's email is not confirmed, then the
    # primary login address cannot be changed
    string login?;
    # Whether the user should receive an email when they
    # are rolled out of an enterprise
    boolean notify?;
    # An external identifier for an app user, which can be used to look
    # up the user. This can be used to tie user IDs from external
    # identity providers to Box users.
    # 
    # Note: In order to update this field, you need to request a token
    # using the application that created the app user
    @jsondata:Name {value: "external_app_user_id"}
    string externalAppUserId?;
    # Whether the user is required to reset their password
    @jsondata:Name {value: "is_password_reset_required"}
    boolean isPasswordResetRequired?;
    # Whether to exempt the user from enterprise device limits
    @jsondata:Name {value: "is_exempt_from_device_limits"}
    boolean isExemptFromDeviceLimits?;
    # The user’s phone number
    @constraint:String {maxLength: 100}
    string phone?;
    # The user’s total available space in bytes. Set this to `-1` to
    # indicate unlimited storage
    @jsondata:Name {value: "space_amount"}
    int spaceAmount?;
    # The name of the user
    @constraint:String {maxLength: 50}
    string name?;
    # Whether the user can use Box Sync
    @jsondata:Name {value: "is_sync_enabled"}
    boolean isSyncEnabled?;
    # The user’s job title
    @jsondata:Name {value: "job_title"}
    string jobTitle?;
    # Tracking codes allow an admin to generate reports from the
    # admin console and assign an attribute to a specific group
    # of users. This setting must be enabled for an enterprise before it
    # can be used
    @jsondata:Name {value: "tracking_codes"}
    TrackingCode[] trackingCodes?;
    # The user's account status
    "active"|"inactive"|"cannot_delete_edit"|"cannot_delete_edit_upload" status?;
};

public type UpdateGroupMembershipRequest record {
    # The role of the user in the group
    "member"|"admin" role?;
    # Custom configuration for the permissions an admin
    # if a group will receive. This option has no effect
    # on members with a role of `member`.
    # 
    # Setting these permissions overwrites the default
    # access levels of an admin.
    # 
    # Specifying a value of `null` for this object will disable
    # all configurable permissions. Specifying permissions will set
    # them accordingly, omitted permissions will be enabled by default
    @jsondata:Name {value: "configurable_permissions"}
    record {|boolean...;|}? configurablePermissions?;
};

