# A field within a metadata template. Fields can be a basic text, date, or
# number field, a list of options, or a taxonomy
public type MetadataFieldWrite record {
    # Whether this field is hidden in the UI for the user and can only be set
    # through the API instead
    boolean hidden?;
    # The unique key of the metadata taxonomy to use for this taxonomy field.
    # This property is required when the field `type` is set to `taxonomy`
    string taxonomyKey?;
    # The display name of the field as it is shown to the user in the web and
    # mobile apps
    @constraint:String {maxLength: 4096}
    string displayName;
    # The unique ID of the metadata taxonomy to use for this taxonomy field.
    # This property is required when the field `type` is set to `taxonomy`
    string taxonomyId?;
    # A list of options for this field. This is used in combination with the
    # `enum` and `multiSelect` field types
    MetadataOptionWrite[] options?;
    # The namespace of the metadata taxonomy to use for this taxonomy field.
    # This property is required when the field `type` is set to `taxonomy`
    string namespace?;
    # A description of the field. This is not shown to the user
    @constraint:String {maxLength: 4096}
    string description?;
    # The type of field. The basic fields are a `string` field for text, a
    # `float` field for numbers, and a `date` field to present the user with a
    # date-time picker.
    # 
    # Additionally, metadata templates support an `enum` field for a basic list
    # of items, and `multiSelect` field for a similar list of items where the
    # user can select more than one value.
    # 
    # Metadata taxonomies are also supported as a `taxonomy` field type 
    # with a specific set of additional properties, which describe its structure
    "string"|"float"|"date"|"enum"|"multiSelect"|"taxonomy" 'type;
    # An object defining additional rules for the options of the taxonomy field.
    # This property is required when the field `type` is set to `taxonomy`
    MetadataTemplateOptionsRules optionsRules?;
    # A unique identifier for the field. The identifier must
    # be unique within the template to which it belongs
    @constraint:String {maxLength: 256}
    string 'key;
};

# AI LLM endpoint params OpenAI object
public type AiLlmEndpointParamsOpenAi record {
    # An alternative to sampling with temperature, called nucleus sampling, where the model considers the results 
    # of the tokens with `top_p` probability mass. So 0.1 means only the tokens comprising the top 10% probability 
    # mass are considered. We generally recommend altering this or temperature but not both
    @jsondata:Name {value: "top_p"}
    decimal? topP?;
    # A number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the 
    # text so far, decreasing the model's likelihood to repeat the same line verbatim
    @jsondata:Name {value: "frequency_penalty"}
    decimal? frequencyPenalty?;
    # Up to 4 sequences where the API will stop generating further tokens
    string? stop?;
    # A number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics
    @jsondata:Name {value: "presence_penalty"}
    decimal? presencePenalty?;
    # What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, 
    # while lower values like 0.2 will make it more focused and deterministic. 
    # We generally recommend altering this or `top_p` but not both
    decimal? temperature?;
    # The type of the AI LLM endpoint params object for OpenAI.
    # This parameter is **required**
    "openai_params" 'type;
};

