    ("open"|"company"|"collaborators")[] allowedSharedLinkAccessLevels?;
    @jsondata:Name {value: "owned_by"}
    UserMini ownedBy?;
    # Whether this item is deleted or not. Values include `active`,
    # `trashed` if the file has been moved to the trash, and `deleted` if
    # the file has been permanently deleted.
    @jsondata:Name {value: "item_status"}
    "active"|"trashed"|"deleted" itemStatus?;
    @jsondata:Name {value: "created_by"}
    UserMini createdBy?;
    # When this file was moved to the trash.
    @jsondata:Name {value: "trashed_at"}
    string? trashedAt?;
    # The collections that this web link belongs to.
