    record {@jsondata:Name {value: "trigger_type"}
        "WORKFLOW_MANUAL_START" triggerType?; record {string ref?; "trigger_scope" 'type?; record {string id?; "folder" 'type?;} 'object?;}[] scope?; "trigger" 'type?;} trigger?;
