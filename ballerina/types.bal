    # The user’s total available space amount in bytes.
    @jsondata:Name {value: "space_amount"}
    int spaceAmount?;
    # When the user object was last modified.
    @jsondata:Name {value: "modified_at"}
    string modifiedAt?;
    # The user’s job title.
    @jsondata:Name {value: "job_title"}
