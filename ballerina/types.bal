# A full representation of a user, as can be returned from any
# user API endpoint
public type UserFull record {
    *User;
    # Whether the user can see other enterprise users in their contact list.
    @jsondata:Name {value: "can_see_managed_users"}
    boolean canSeeManagedUsers?;
    # The user’s enterprise role.
    "admin"|"coadmin"|"user" role?;
    # Whether the user must use two-factor authentication.
    @jsondata:Name {value: "is_exempt_from_login_verification"}
    boolean isExemptFromLoginVerification?;
    record {string name?; string id?; "enterprise" 'type?;} enterprise?;
    # Whether the user is allowed to collaborate with users outside their
    # enterprise.
    @jsondata:Name {value: "is_external_collab_restricted"}
    boolean isExternalCollabRestricted?;
    # Whether collaborators can access content owned by the user when the
    # user is inactive. This setting preserves existing collaborator access
    # and does not grant new permissions.
    @jsondata:Name {value: "is_collaborated_content_available_when_owner_inactive"}
    boolean isCollaboratedContentAvailableWhenOwnerInactive?;
    # An external identifier for an app user, which can be used to look up
    # the user. This can be used to tie user IDs from external identity
    # providers to Box users.
    @jsondata:Name {value: "external_app_user_id"}
    string externalAppUserId?;
    # The root (protocol, subdomain, domain) of any links that need to be
    # generated for the user.
    string hostname?;
    # Whether to exempt the user from Enterprise device limits.
    @jsondata:Name {value: "is_exempt_from_device_limits"}
    boolean isExemptFromDeviceLimits?;
    # Whether the user can use Box Sync.
    @jsondata:Name {value: "is_sync_enabled"}
    boolean isSyncEnabled?;
    # Whether the user is an App User.
    @jsondata:Name {value: "is_platform_access_only"}
    boolean isPlatformAccessOnly?;
    # Tracking codes allow an admin to generate reports from the
    # admin console and assign an attribute to a specific group
    # of users. This setting must be enabled for an enterprise
    # before it can be used.
    @jsondata:Name {value: "tracking_codes"}
    TrackingCode[] trackingCodes?;
    # Tags for all files and folders owned by the user. Values returned
    # will only contain tags that were set by the requester.
    @jsondata:Name {value: "my_tags"}
    string[] myTags?;
};

# The item to be processed by the LLM for ask requests
public type AiItemAsk record {
    # The ID of the file, or the ID of the Box Hub when `type` is `hubs`
    string id;
    # The type of the item. Use `file` to ask a question about a file, or `hubs` to
    # search across and ask a question about the entire contents of a Box Hub.
    # A `hubs` item must be the only item in the request
    "file"|"hubs" 'type;
    # The content of the item, often the text representation
    string content?;
};

# An app item association represents an association between a file or
# folder and an app item. Associations between a folder and an app item
# cascade down to all descendants of the folder
public type AppItemAssociation record {
    # The file, folder or web link which is associated with the app item
    AppItemAssociatedItem item;
    @jsondata:Name {value: "app_item"}
    AppItem appItem;
    # The unique identifier for this app item association
    string id;
    # The value will always be `app_item_association`
    "app_item_association" 'type;
};

# The task to assign to a user
public type TaskAssignmentsTask record {
    # The ID of the task
    string id;
    # The type of the item to assign
    "task" 'type;
};

# A list of device pins
public type DevicePinners record {
    # The marker for the start of the next page of results
    @jsondata:Name {value: "next_marker"}
    int nextMarker?;
    # A list of device pins
    DevicePinner[] entries?;
    # The limit that was used for these entries. This will be the same as the
    # `limit` query parameter unless that value exceeded the maximum value
    # allowed
    int 'limit = 100;
    # The order by which items are returned
    DevicePinnersOrder[] 'order?;
};

# A retention assignment represents a rule specifying
# the files a retention policy retains.
# Assignments can retain files based on their folder or metadata,
# or hold all files in the enterprise
public type RetentionPolicyAssignment record {
    @jsondata:Name {value: "retention_policy"}
    RetentionPolicyMini retentionPolicy?;
    # When the retention policy assignment object was
    # created
    @jsondata:Name {value: "assigned_at"}
    string assignedAt?;
    # The unique identifier for a retention policy assignment
    string id;
    @jsondata:Name {value: "assigned_by"}
    UserMini assignedBy?;
    # The value will always be `retention_policy_assignment`
    "retention_policy_assignment" 'type;
    @jsondata:Name {value: "assigned_to"}
    RetentionPolicyAssignmentAssignedTo assignedTo?;
    # An array of field objects. Values are only returned if the `assigned_to`
    # type is `metadata_template`. Otherwise, the array is blank
    @jsondata:Name {value: "filter_fields"}
    RetentionPolicyAssignmentFilterFields[]? filterFields?;
    # The date the retention policy assignment begins.
    # If the `assigned_to` type is `metadata_template`,
    # this field can be a date field's metadata attribute key id
    @jsondata:Name {value: "start_date_field"}
    string startDateField?;
};

# An individual classification
public type InitialClassificationsOptions record {
    # Additional information about the classification
    InitialClassificationsStaticConfig staticConfig?;
    # The display name and key this classification. This
    # will be show in the Box UI
    string 'key;
};

# The user or group to give access to the item
public type CollaborationsAccessibleBy record {
    # The ID of the user or group.
